{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "tests/integration/**/*.ts",
    "tests/operator/**/*.ts",
    "playwright.operator.config.ts",
    "vitest.config.ts"
  ]
}
