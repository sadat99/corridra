{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Corridra brand identity layer. Extends AC/1 Atlantic Cobalt (docs/source/ac1-design-system/atlantic-cobalt.tokens.json); it does not redefine any AC/1 colour. Colour values below are AC/1 primitives, listed by their CSS token name.",
  "identity": {
    "name": {
      "$value": "Corridra"
    },
    "wordmarkRule": {
      "$value": "The lettering is artwork. Never retype it in Geist, Newsreader or any other face."
    },
    "status": {
      "$value": "Owner-supplied logo adopted by owner instruction. Art-direction review, trademark check and legal handoff are still open (docs/adr/0077-corridra-visual-identity.md)."
    }
  },
  "color": {
    "mark": {
      "light": {
        "$value": "--brand",
        "hex": "#2856C5"
      },
      "dark": {
        "$value": "--on-brand",
        "hex": "#FFFFFF"
      }
    },
    "wordmark": {
      "light": {
        "$value": "--brand-deep",
        "hex": "#142438"
      },
      "dark": {
        "$value": "--on-brand",
        "hex": "#FFFFFF"
      }
    },
    "accentBar": {
      "$value": "--editorial-accent",
      "hex": "#BF7548",
      "note": "Decorative only. Never text, never a status colour, never under 24 px wide."
    },
    "forbidden": {
      "$value": [
        "#FE8E03",
        "#041B46",
        "any gradient",
        "any shadow",
        "any opacity under 100 percent"
      ],
      "note": "#FE8E03 and #041B46 are the colours of the original supplied artwork, kept only in docs/brand/assets/legacy-orange."
    }
  },
  "contrast": {
    "cobaltOnPorcelain": 6.12,
    "cobaltOnWhite": 6.51,
    "navyOnPorcelain": 14.74,
    "whiteOnNavy": 15.68,
    "whiteOnCobalt": 6.51,
    "copperOnPorcelain": 3.37,
    "cobaltOnNavy": 2.41,
    "note": "Cobalt on navy fails. Use the reversed colorway on navy."
  },
  "clearSpace": {
    "$value": "X",
    "definition": "X is the height of the letter C in the wordmark. For orb-only use, X is one quarter of the orb diameter. Keep at least X free on every side."
  },
  "sizeLadder": [
    {
      "context": "The 16 px favicon file only (ADR-077 amendment 1)",
      "asset": "orb"
    },
    {
      "context": "Product chrome 44 px tall beside the wordmark: public and signed-in headers, collapsed rail, footer (ADR-077 amendment 1)",
      "asset": "mark, painted by CSS from the mask file (BrandMark in site-header.tsx)"
    },
    {
      "context": "Under 44 px outside the 16 px favicon: avatar, any other small slot",
      "asset": "orb"
    },
    {
      "context": "Product chrome lockup in a file, 24 to 40 px tall",
      "asset": "lockup-compact"
    },
    {
      "context": "Full lockup 120 px wide and up",
      "asset": "lockup-stacked or lockup-horizontal"
    },
    {
      "context": "Large brand moments 64 px and up, square",
      "asset": "mark"
    },
    {
      "context": "App icon 180 px and up",
      "asset": "mark on a navy tile (app-icons)"
    }
  ],
  "orb": {
    "viewBox": "10 10 42 42",
    "path": "M51.80 28.12A21.0 21.0 0 1 0 41.18 49.37A12.5 12.5 0 1 1 51.80 28.12Z",
    "dot": {
      "cx": 46,
      "cy": 40,
      "r": 3.4
    },
    "construction": "Disc of radius 21 at (31,31) minus a circle of radius 12.5 at (43,37), plus a dot of radius 3.4 at (46,40)."
  },
  "assets": {
    "mark": {
      "$description": "Large brand moments, app icons, the favicon at 32 px and up, and product chrome at 44 px tall (ADR-077 amendment 1). Minimum 64 px wide in print and on pages, 44 px tall in headers.",
